generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum CategoryType {
  CREDIT
  DEBIT
  TRANSFER
}

enum Direction {
  CREDIT
  DEBIT
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  OTHER
}

model Account {
  id                  Int                 @id @default(autoincrement())
  name                String              @unique
  institution         String?
  type                AccountType
  /// Signed: positive for money you have, negative for money owed (e.g. a credit card)
  openingBalanceCents Int                 @default(0)
  transactions        Transaction[]
  templates           StatementTemplate[]
  createdAt           DateTime            @default(now())
}

model CategoryGroup {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  categories Category[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  type         CategoryType
  groupId      Int
  group        CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([groupId])
}

model Transaction {
  id            Int          @id @default(autoincrement())
  /// Calendar date stored as UTC midnight
  date          DateTime
  description   String
  /// Always positive; the sign comes from `direction`
  amountCents   Int
  direction     Direction
  categoryId    Int
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accountId     Int
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([importBatchId])
}

model ImportBatch {
  id           Int           @id @default(autoincrement())
  fileName     String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model StatementTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  /// Text that identifies the bank's statements, matched case-insensitively
  fingerprint String
  /// JSON-encoded TemplateConfig (see lib/import/types.ts)
  config      String
  /// Account pre-selected when this template matches a statement
  accountId   Int?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}
